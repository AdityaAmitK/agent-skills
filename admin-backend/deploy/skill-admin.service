[Unit]
Description=T3 settings skills administration
After=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/agent-skills
ExecStart=/usr/bin/python3 %h/agent-skills/admin-backend/server.py --mode admin --port 18340
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
