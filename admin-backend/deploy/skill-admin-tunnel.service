[Unit]
Description=Cloudflare Access protected T3 settings tunnel
After=network-online.target skill-admin.service
Wants=network-online.target

[Service]
Type=simple
UMask=0077
ExecStart=%h/.local/bin/cloudflared tunnel --no-autoupdate --loglevel warn --metrics 127.0.0.1:18343 run --token-file %h/.local/share/skill-admin/tunnel.token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
